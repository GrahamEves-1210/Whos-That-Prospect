# Copy to .env.local and fill in from Supabase: Project Settings > Data API.
# Use the base project URL (no /rest/v1/ on the end).
# Without these, the game runs normally and Profile / Leaderboard say accounts aren't set up.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
